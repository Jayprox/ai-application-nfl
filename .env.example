# Copy this file to .env and fill in real values. Never commit .env itself.

# Postgres connection string for the Railway-hosted database.
# Get this from the Railway dashboard: Postgres service -> Variables tab
# -> DATABASE_URL (use the public/proxy connection string if running
# locally rather than from within Railway; DATABASE_PUBLIC_URL once
# public networking is enabled on the Postgres service).
DATABASE_URL=postgres://user:password@host:port/database

# Any long random string works for local dev — this signs JWT access
# tokens. Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# In Railway, set this as a real secret on backend-api's Variables tab —
# never commit the real value.
JWT_SECRET=replace-with-a-long-random-string

# Local port for backend-api. Railway sets its own PORT automatically in
# production — this is only used when running locally.
PORT=3000

# Allowed origin(s) for browser requests (the React web app). Comma-separate
# multiple values. Defaults to the local Vite dev server if unset. Once the
# frontend is deployed on Railway, set this to its real https:// URL there.
CORS_ORIGIN=http://localhost:5173

# ---------------------------------------------------------------------
# ingestion-worker only — Part 2 Phase 1 data vendors (docs/part2-roadmap.md)
# ---------------------------------------------------------------------

# The Odds API (the-odds-api.com), free tier. Sign up at the-odds-api.com
# to get a key — this is a personal account/API key, not something to
# create on someone else's behalf, so this has to be done by whoever owns
# the project. Powers worker/ingestion-worker.js's sync_odds job. Not yet
# provisioned anywhere as of this commit — sync_odds logs a warning and
# no-ops until this is set.
ODDS_API_KEY=

# Highlightly (highlightly.net / RapidAPI), free tier. Will power
# sync_injury_reports and sync_live_stats once those are wired up (still
# stubs as of this commit — see worker/ingestion-worker.js's file header).
# Not needed yet; placeholder for when that lands.
HIGHLIGHTLY_API_KEY=
