# Copy this file to .env and adjust if needed (same convention as the
# backend's .env — already covered by the repo's root .gitignore). Vite
# only exposes variables prefixed VITE_ to client-side code — never put
# secrets here, this ships to the browser.

# backend-api's URL. Defaults to the local backend if unset. Set this to
# the real Railway backend-api URL once both services are deployed.
VITE_API_URL=http://localhost:3000
